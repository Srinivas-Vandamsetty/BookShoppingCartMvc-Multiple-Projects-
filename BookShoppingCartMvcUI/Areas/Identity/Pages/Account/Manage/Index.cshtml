@page
@model IndexModel
@{
    ViewData["Title"] = "Personal Information";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<section class="account-profile">
    <header class="account-profile__heading">
        <span class="account-profile__heading-icon"><i class="bi bi-person"></i></span>
        <div><h1>Personal Information</h1><p>Keep your account details up to date for a smoother BookVerse experience.</p></div>
    </header>
    <partial name="_StatusMessage" for="StatusMessage" />
    <form id="profile-form" method="post" class="account-profile__form">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="account-profile__fields">
            <div class="account-field"><label>Full name</label><div class="account-readonly"><i class="bi bi-person"></i><span>@Model.Username</span></div><small>Your username is managed by your account administrator.</small></div>
            <div class="account-field"><label>Email address</label><div class="account-readonly"><i class="bi bi-envelope"></i><span>@Model.Email</span></div><small>Use Email settings to change or verify your email.</small></div>
            <div class="account-field account-field--wide"><label asp-for="Input.PhoneNumber"></label><div class="account-input-wrap"><i class="bi bi-telephone"></i><input asp-for="Input.PhoneNumber" autocomplete="tel" placeholder="Enter your phone number" /></div><span asp-validation-for="Input.PhoneNumber" class="text-danger"></span></div>
        </div>
        <button id="update-profile-button" type="submit" class="account-profile__save">Update Profile <i class="bi bi-arrow-right"></i></button>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
