@inject SignInManager<IdentityUser> SignInManager
@{ var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any(); }
<nav class="account-nav" aria-label="Account settings navigation">
    <a class="@ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index"><i class="bi bi-person"></i><span>Personal Information</span></a>
    <a class="@ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email"><i class="bi bi-bell"></i><span>Email &amp; Notifications</span></a>
    <a class="@ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword"><i class="bi bi-shield-lock"></i><span>Password &amp; Security</span></a>
    @if (hasExternalLogins) { <a class="@ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins"><i class="bi bi-link-45deg"></i><span>Linked Accounts</span></a> }
    <a href="/UserOrder/UserOrders"><i class="bi bi-box-seam"></i><span>My Orders</span></a>
</nav>
