@using System.Security.Claims
@{
    Layout = ViewData.TryGetValue("ParentLayout", out var parentLayout)
        ? parentLayout as string ?? "/Views/Shared/_Layout.cshtml"
        : "/Views/Shared/_Layout.cshtml";
    var name = User.Identity?.Name ?? "Reader";
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Customer";
}

<section class="account-settings">
    <div class="account-settings__hero">
        <div><p class="account-settings__eyebrow">BOOKVERSE ACCOUNT</p><h1>Account Settings</h1><p>Manage your profile, security, and bookstore preferences.</p></div>
        <div class="account-settings__identity"><span class="account-avatar">@initials</span><span><small>Hello, @name</small><strong><i class="bi bi-patch-check-fill"></i> Verified Account</strong></span></div>
    </div>
    <div class="account-settings__grid">
        <aside class="account-settings__nav"><partial name="_ManageNav" /></aside>
        <main class="account-settings__content">@RenderBody()</main>
        <aside class="account-settings__summary">
            <div class="account-summary__top"><span class="account-avatar account-avatar--large">@initials</span><div><h2>@name</h2><span class="account-role">@role</span><p><i class="bi bi-check-circle-fill"></i> Verified Account</p></div></div>
            <div class="account-summary__security"><h3><i class="bi bi-shield-check"></i> Account Security</h3><p><i class="bi bi-check-circle-fill"></i> Email verified</p><p><i class="bi bi-check-circle-fill"></i> Secure sign-in</p><a asp-page="./ChangePassword">Manage password <i class="bi bi-arrow-right"></i></a></div>
            <a class="account-summary__orders" href="/UserOrder/UserOrders"><i class="bi bi-box-seam"></i><span><strong>Order History</strong><small>View and track your past orders.</small></span><i class="bi bi-arrow-right"></i></a>
        </aside>
    </div>
</section>

@section Scripts { @RenderSection("Scripts", required: false) }
