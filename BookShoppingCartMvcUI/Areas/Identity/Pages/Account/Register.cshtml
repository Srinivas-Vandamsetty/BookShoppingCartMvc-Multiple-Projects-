@page
@model RegisterModel
@{
    ViewData["Title"] = "Join BookVerse";
}
<link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />

<section class="bv-register" aria-labelledby="register-title">
    <div class="bv-register__backdrop" aria-hidden="true"></div>
    <div class="bv-register__content">
        <div class="bv-register__card">
            <div class="bv-register__brand" aria-label="BookVerse Reading Club">
                <i class="bi bi-bookshelf" aria-hidden="true"></i><strong>Book<span>Verse</span></strong>
                <p><span></span> Reading Club <span></span></p>
            </div>
            <header class="bv-register__heading">
                <h1 id="register-title">Join BookVerse</h1>
                <p>Create your free account and be part of our reading club.</p>
            </header>
            <form id="bookverse-register" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div asp-validation-summary="ModelOnly" class="bv-register__errors" role="alert" aria-live="polite"></div>
                <div class="bv-register__field">
                    <label asp-for="Input.UserName">Username</label>
                    <div class="bv-register__input-wrap"><i class="bi bi-person-fill" aria-hidden="true"></i><input asp-for="Input.UserName" autocomplete="username" placeholder="Choose a username" autofocus /></div>
                    <span asp-validation-for="Input.UserName" class="bv-register__field-error"></span>
                </div>
                <div class="bv-register__field">
                    <label asp-for="Input.Email">Email address</label>
                    <div class="bv-register__input-wrap"><i class="bi bi-envelope-fill" aria-hidden="true"></i><input asp-for="Input.Email" autocomplete="email" inputmode="email" placeholder="you@example.com" /></div>
                    <span asp-validation-for="Input.Email" class="bv-register__field-error"></span>
                </div>
                <div class="bv-register__field">
                    <label asp-for="Input.Password">Password</label>
                    <div class="bv-register__input-wrap bv-register__input-wrap--password"><i class="bi bi-lock-fill" aria-hidden="true"></i><input asp-for="Input.Password" autocomplete="new-password" placeholder="Create a password" /><button type="button" class="bv-register__visibility" data-password-toggle="Input_Password" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
                    <span asp-validation-for="Input.Password" class="bv-register__field-error"></span>
                </div>
                <div class="bv-register__field">
                    <label asp-for="Input.ConfirmPassword">Confirm password</label>
                    <div class="bv-register__input-wrap bv-register__input-wrap--password"><i class="bi bi-lock-fill" aria-hidden="true"></i><input asp-for="Input.ConfirmPassword" autocomplete="new-password" placeholder="Repeat your password" /><button type="button" class="bv-register__visibility" data-password-toggle="Input_ConfirmPassword" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
                    <span asp-validation-for="Input.ConfirmPassword" class="bv-register__field-error"></span>
                </div>
                <div class="bv-register__field bv-register__field--optional">
                    <label asp-for="Input.PhoneNumber">Phone number, optional</label>
                    <div class="bv-register__input-wrap"><i class="bi bi-telephone-fill" aria-hidden="true"></i><input asp-for="Input.PhoneNumber" autocomplete="tel" inputmode="tel" placeholder="Phone number, optional" /></div>
                    <span asp-validation-for="Input.PhoneNumber" class="bv-register__field-error"></span>
                </div>
                <div class="bv-register__strength" aria-live="polite"><span>Password strength</span><div class="bv-register__strength-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></div><strong id="password-strength">Enter a password</strong></div>
                <button id="register-submit" class="bv-register__submit" type="submit"><span id="register-button-text">Create free account</span><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <p class="bv-register__progress" id="register-progress" role="status" aria-live="polite"></p>
            </form>
            <p class="bv-register__signin">Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></p>
        </div>
        <aside class="bv-register__benefits" aria-label="Membership benefits">
            <div><i class="bi bi-book" aria-hidden="true"></i><span>Personalized<br />recommendations</span></div>
            <div><i class="bi bi-shield-check" aria-hidden="true"></i><span>Secure<br />checkout</span></div>
            <div><i class="bi bi-heart" aria-hidden="true"></i><span>Saved<br />wishlists</span></div>
        </aside>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/register.js" asp-append-version="true"></script>
}
