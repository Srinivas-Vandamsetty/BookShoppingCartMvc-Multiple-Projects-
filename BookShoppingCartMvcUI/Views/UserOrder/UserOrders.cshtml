@model IEnumerable<Order>
@{
    var orders = Model?.ToList() ?? [];
    var delivered = orders.Count(order => string.Equals(order.OrderStatus.StatusName, "Delivered", StringComparison.OrdinalIgnoreCase));
    var inTransit = orders.Count(order => string.Equals(order.OrderStatus.StatusName, "Shipped", StringComparison.OrdinalIgnoreCase));
}

<section class="reading-journey">
    <div class="reading-journey__header"><p>Your Reading Journey</p><h1>My Orders</h1></div>
    @if (orders.Any())
    {
        <div class="reading-journey__layout">
            <div class="reading-journey__timeline" aria-hidden="true"></div>
            <main class="reading-journey__orders">
                @foreach (var order in orders)
                {
                    var status = order.OrderStatus.StatusName;
                    var normalizedStatus = status.ToLowerInvariant();
                    var shipped = normalizedStatus is "shipped" or "delivered";
                    var isDelivered = normalizedStatus == "delivered";
                    var primaryItem = order.OrderDetail?.FirstOrDefault();
                    var title = primaryItem is null ? "Your book order" : string.IsNullOrWhiteSpace(primaryItem.BookName) ? primaryItem.Book.BookName : primaryItem.BookName;
                    var image = primaryItem?.Book?.Image;
                    <article class="journey-order-card">
                        <div class="journey-order-card__date"><span><i class="bi bi-circle-fill"></i></span><strong>@order.CreateDate.ToString("dd MMM, yyyy")</strong><small>Order #BV-@order.Id</small></div>
                        <img class="journey-order-card__cover" src="@(string.IsNullOrWhiteSpace(image) ? "/images/NoImage.png" : $"/images/{image}")" alt="@title cover" />
                        <div class="journey-order-card__body">
                            <div class="journey-order-card__meta"><span>Order ID: <strong>#BV-@order.Id</strong></span><span>Purchase Date: @order.CreateDate.ToString("dd MMM yyyy")</span></div>
                            <h2>@title</h2><p>@(order.OrderDetail?.Sum(item => item.Quantity) ?? 0) item@((order.OrderDetail?.Sum(item => item.Quantity) ?? 0) == 1 ? "" : "s") · @status</p>
                            <div class="journey-progress @(normalizedStatus is "cancelled" or "returned" ? "journey-progress--cancelled" : "")">
                                <div class="journey-progress__step is-complete"><i class="bi bi-check-lg"></i><span>Order Placed</span></div>
                                <div class="journey-progress__line @(shipped ? "is-complete" : "")"></div>
                                <div class="journey-progress__step @(shipped ? "is-complete" : "")"><i class="bi bi-truck"></i><span>Shipped</span></div>
                                <div class="journey-progress__line @(isDelivered ? "is-complete" : "")"></div>
                                <div class="journey-progress__step @(isDelivered ? "is-complete" : "")"><i class="bi bi-box-seam"></i><span>Delivered</span></div>
                            </div>
                        </div>
                        <div class="journey-order-card__actions"><p>Total: <strong>₹@order.Total.ToString("N2")</strong></p><a asp-action="Details" asp-route-id="@order.Id" class="journey-btn journey-btn--primary">View Order</a><a asp-controller="FrontPage" asp-action="Contact" class="journey-btn">Get Help</a></div>
                    </article>
                }
                <partial name="_OrderPaging" />
            </main>
            <aside class="reading-journey__side">
                <section class="journey-side-card"><h2><i class="bi bi-bar-chart-line"></i> Order Summary</h2><div><i class="bi bi-cart3"></i><span>Total Orders</span><strong>@orders.Count</strong></div><div><i class="bi bi-box-seam"></i><span>Delivered</span><strong class="is-success">@delivered</strong></div><div><i class="bi bi-truck"></i><span>In Transit</span><strong class="is-warning">@inTransit</strong></div></section>
                <section class="journey-side-card journey-side-card--help"><h2><i class="bi bi-question-circle"></i> Need help?</h2><p>Have a question about an order, delivery, or return? Our support team is here to help.</p><a asp-controller="FrontPage" asp-action="Contact" class="journey-btn journey-btn--primary">Get Help</a></section>
            </aside>
        </div>
    }
    else
    {
        <div class="journey-empty"><img src="/images/EmptyCartImage.png" alt="No orders yet" /><h2>Your reading journey starts here</h2><p>You have not placed an order yet. Explore the BookVerse collection to find your next read.</p><a asp-controller="Home" asp-action="Index" class="journey-btn journey-btn--primary">Browse Books</a></div>
    }
</section>
