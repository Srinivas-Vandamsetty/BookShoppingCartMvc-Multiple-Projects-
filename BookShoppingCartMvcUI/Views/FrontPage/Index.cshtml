@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="bookverse-home">
    <section class="bookverse-hero">
        <div class="container position-relative h-100">
            <div class="bookverse-hero__content">
                <p class="bookverse-eyebrow"><i class="bi bi-stars"></i> Your next favourite story awaits</p>
                <h1>Discover books that stay with you.</h1>
                <p class="bookverse-hero__description">Explore a carefully selected collection of fiction, learning, and unforgettable reads for every kind of reader.</p>
                <div class="bookverse-hero__actions">
                    <a asp-action="Index" asp-controller="Home" class="btn bookverse-button bookverse-button--primary">Browse collection <i class="bi bi-arrow-right"></i></a>
                    <a asp-action="Shop" asp-controller="FrontPage" class="btn bookverse-button bookverse-button--outline">Explore categories</a>
                </div>
                <div class="bookverse-hero__proof">
                    <span><i class="bi bi-patch-check-fill"></i> Curated selections</span>
                    <span><i class="bi bi-truck"></i> Free delivery over ₹999</span>
                </div>
            </div>
        </div>
    </section>

    <section class="bookverse-benefits" aria-label="BookVerse benefits">
        <div class="container"><div class="row g-0">
            <div class="col-md-4"><div class="bookverse-benefit"><span class="bookverse-benefit__icon"><i class="bi bi-truck"></i></span><div><strong>Free delivery</strong><span>On orders over ₹999</span></div></div></div>
            <div class="col-md-4"><div class="bookverse-benefit"><span class="bookverse-benefit__icon"><i class="bi bi-shield-check"></i></span><div><strong>Secure checkout</strong><span>Safe payments every time</span></div></div></div>
            <div class="col-md-4"><div class="bookverse-benefit"><span class="bookverse-benefit__icon"><i class="bi bi-arrow-repeat"></i></span><div><strong>Easy returns</strong><span>Simple 3-day refund process</span></div></div></div>
        </div></div>
    </section>

    <section class="bookverse-discover">
        <div class="container">
            <div class="bookverse-section-heading">
                <div><p class="bookverse-eyebrow bookverse-eyebrow--dark">Find your next read</p><h2>Choose a reading mood</h2></div>
                <a asp-action="Index" asp-controller="Home" class="bookverse-text-link">View all books <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="row g-4">
                <div class="col-md-4"><a asp-action="Index" asp-controller="Home" class="bookverse-category-card bookverse-category-card--fiction"><span>01</span><h3>Escape into fiction</h3><p>Stories to transport you.</p><i class="bi bi-arrow-up-right"></i></a></div>
                <div class="col-md-4"><a asp-action="Index" asp-controller="Home" class="bookverse-category-card bookverse-category-card--learning"><span>02</span><h3>Keep learning</h3><p>Ideas that move you forward.</p><i class="bi bi-arrow-up-right"></i></a></div>
                <div class="col-md-4"><a asp-action="Index" asp-controller="Home" class="bookverse-category-card bookverse-category-card--children"><span>03</span><h3>Share the joy</h3><p>Stories for young readers.</p><i class="bi bi-arrow-up-right"></i></a></div>
            </div>
        </div>
    </section>
</main>
