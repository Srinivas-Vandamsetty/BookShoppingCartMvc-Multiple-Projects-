@model BookShoppingCart.Models.Models.DTOs.GenreDTO

@{
    Layout = "_AdminLayout";
}

<section class="admin-page admin-page--form">
    <div class="admin-page__header">
        <div><h1><i class="bi bi-pencil-square"></i>Update genre</h1><p>Rename this category across your catalogue.</p></div>
        <a asp-action="Index" asp-controller="Genre" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <form asp-action="UpdateGenre" method="post" class="shadow-lg">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Genre Name*</label>
            <input type="text" class="form-control" asp-for="GenreName" />
            <span asp-validation-for="GenreName" class="text-danger small"></span>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-warning w-100">
                <i class="bi bi-pencil-square"></i> Update Genre
            </button>
        </div>
    </form>
</section>
