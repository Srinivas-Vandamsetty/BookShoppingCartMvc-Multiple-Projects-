@using BookShoppingCart.Models.Models.DTOs
@model GenreDTO

@{
    Layout = "_AdminLayout";
}

<section class="admin-page admin-page--form">
    <div class="admin-page__header">
        <div><h1><i class="bi bi-layers"></i>Add genre</h1><p>Create a category for organizing books.</p></div>
        <a asp-action="Index" asp-controller="Genre" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <form asp-action="AddGenre" method="post" class="shadow-lg" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Genre Name*</label>
            <input type="text" class="form-control" asp-for="GenreName" placeholder="Enter genre name" />
            <span asp-validation-for="GenreName" class="text-danger small"></span>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-warning w-100">
                <i class="bi bi-plus-circle"></i> Add Genre
            </button>
        </div>
    </form>
</section>
