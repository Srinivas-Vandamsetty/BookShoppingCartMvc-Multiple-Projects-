@using BookShoppingCart.Models.Models
@model IEnumerable<Genre>

@{
    Layout = "_AdminLayout";
}

<section class="admin-page">
    <div class="admin-page__header">
        <div><h1><i class="bi bi-layers"></i>Genres</h1><p>Organize the categories used throughout your book catalogue.</p></div>
        <a asp-action="AddGenre" asp-controller="Genre" class="btn btn-warning">
            <i class="bi bi-plus-circle me-1"></i> Add New Genre
        </a>
    </div>

    @if (Model?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table admin-genres-table align-middle table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Genre</th>
                        <th>Books</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var genre in Model)
                    {
                        <tr>
                            <td class="fw-semibold"><span class="admin-genre-name"><i class="bi bi-bookmark-fill"></i>@genre.GenreName</span></td>
                            <td>
                                @if (genre.BookCount > 0)
                                {
                                    <span class="badge admin-linked-badge"><i class="bi bi-link-45deg"></i> @genre.BookCount linked book@(genre.BookCount == 1 ? "" : "s")</span>
                                }
                                else
                                {
                                    <span class="admin-empty-link"><i class="bi bi-check-circle"></i> No linked books</span>
                                }
                            </td>
                            <td>
                                <div class="admin-table-actions" role="group">
                                    <a asp-action="UpdateGenre" asp-controller="Genre" asp-route-id="@genre.Id"
                                       class="btn btn-success btn-sm" title="Edit @genre.GenreName" aria-label="Edit @genre.GenreName">
                                        <i class="bi bi-pencil-square"></i><span class="visually-hidden"> Edit</span>
                                    </a>
                                    @if (genre.BookCount > 0)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="This genre has linked books and cannot be deleted.">
                                            <i class="bi bi-lock-fill"></i> In use
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="DeleteGenre" method="post" class="d-inline" onsubmit="return confirm('Delete this empty genre? This cannot be undone.');">
                                            <input type="hidden" name="id" value="@genre.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm" title="Delete @genre.GenreName" aria-label="Delete @genre.GenreName">
                                                <i class="bi bi-trash"></i><span class="visually-hidden"> Delete</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-3">
            No genres found. Click <strong>Add New Genre</strong> to get started.
        </div>
    }
</section>
