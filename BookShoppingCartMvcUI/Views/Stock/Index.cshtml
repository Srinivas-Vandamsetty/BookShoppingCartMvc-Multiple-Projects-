@model IEnumerable<StockDisplayModel>
@{
    Layout = "_AdminLayout";
}

<section class="admin-page">
    <div class="admin-page__header">
        <div><h1><i class="bi bi-box-seam"></i>Stock management</h1><p>Search books and keep inventory quantities accurate.</p></div>
    </div>

    <form asp-action="Index" method="get" class="admin-filter-bar">
        <div class="filter-field"><label class="visually-hidden" for="stock-search">Search stock</label><input id="stock-search" type="text" name="sTerm" class="form-control" value="@Context.Request.Query["sTerm"]" placeholder="Search by book name..." /></div>
        <div class="filter-actions"><button type="submit" class="btn btn-warning">
            <i class="bi bi-search"></i> Search
        </button>
        <a asp-action="Index" asp-controller="Stock" class="btn btn-secondary">
            <i class="bi bi-x-circle"></i> Clear
        </a></div>
    </form>

    @if (Model?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table admin-stock-table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Book</th>
                        <th>Quantity In Stock</th>
                        <th style="width: 180px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium"><span class="admin-stock-book"><i class="bi bi-book"></i>@item.BookName</span></td>
                            <td>
                                <span class="stock-count @(item.Quantity <= 5 ? "stock-count--low" : "stock-count--healthy")"><i class="bi bi-@(item.Quantity <= 5 ? "exclamation-triangle" : "check-circle")"></i> @item.Quantity @(item.Quantity == 1 ? "copy" : "copies")</span>
                            </td>
                            <td>
                                <a asp-action="ManangeStock" asp-controller="Stock" asp-route-bookId="@item.BookId"
                                   class="btn btn-warning btn-sm">
                                    <i class="bi bi-box-seam"></i> Update Stock
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-3">
            No stock records found. Try searching for another book.
        </div>
    }
</section>

<partial name="_OrderPaging" />
