@model StockDTO
@{
    Layout = "_AdminLayout";
}

<section class="admin-page admin-page--form">
    <div class="admin-page__header">
        <div><h1><i class="bi bi-box-seam"></i>Manage stock</h1><p>Record an inventory adjustment with an audit reason.</p></div>
        <a asp-action="Index" asp-controller="Stock" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <form asp-action="ManangeStock" class="shadow-lg">
        <input type="hidden" asp-for="BookId" />
        <input type="hidden" asp-for="ExpectedQuantity" />
        <input type="hidden" asp-for="OperationId" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Quantity*</label>
            <input type="number" class="form-control" asp-for="Quantity" />
            <span asp-validation-for="Quantity" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Reason" class="form-label fw-bold">Adjustment reason</label>
            <textarea asp-for="Reason" class="form-control" maxlength="300" required></textarea>
            <span asp-validation-for="Reason" class="text-danger small"></span>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-warning w-100">
                <i class="bi bi-arrow-repeat"></i> Update Stock
            </button>
        </div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
