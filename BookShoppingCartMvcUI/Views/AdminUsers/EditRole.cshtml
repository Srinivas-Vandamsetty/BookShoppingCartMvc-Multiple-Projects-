@model BookShoppingCartMvcUI.Models.UpdateUserRoleViewModel
@{ Layout = "_AdminLayout"; var roles = ViewBag.Roles as IEnumerable<string> ?? []; }
<section class="admin-page admin-page--form"><div class="admin-page__header"><div><h1><i class="bi bi-shield-lock"></i>Manage Role</h1><p>Choose the access level for this account.</p></div></div>
<form method="post" class="shadow-lg"><input asp-for="UserId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><dl class="admin-user-details"><dt>User</dt><dd>@Model.UserName</dd><dt>Email</dt><dd>@Model.Email</dd></dl><div class="mb-4"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select">@foreach (var role in roles) { <option value="@role">@role</option> }</select><span asp-validation-for="Role" class="text-danger"></span></div><div class="admin-role-explanation"><strong>Permissions</strong><p>Customers shop and manage only their own orders. Employees process orders and view customers. Administrators manage the complete application.</p></div><div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-check2-circle"></i> Save role</button><a asp-action="Index" class="btn btn-secondary">Cancel</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
