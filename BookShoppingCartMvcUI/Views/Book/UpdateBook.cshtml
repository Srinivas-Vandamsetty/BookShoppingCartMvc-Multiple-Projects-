@using BookShoppingCart.Models.Models.DTOs
@model BookDTO
@{
    Layout = "_AdminLayout";
}

<section class="admin-page admin-page--form">
    <div class="admin-page__header">
        <div><h1><i class="bi bi-pencil-square"></i>Update book</h1><p>Update catalogue information and book imagery.</p></div>
        <a asp-action="Index" asp-controller="Book" class="btn btn-primary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <form asp-action="UpdateBook" enctype="multipart/form-data"
          class="shadow-lg">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Image" />

        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Book Name*</label>
            <input type="text" class="form-control" asp-for="BookName" />
            <span asp-validation-for="BookName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Author Name*</label>
            <input type="text" class="form-control" asp-for="AuthorName" />
            <span asp-validation-for="AuthorName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Genre*</label>
            <select class="form-select" asp-for="GenreId" asp-items="Model.GenreList">
                <option value="">-- Select Genre --</option>
            </select>
            <span asp-validation-for="GenreId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Price*</label>
            <input type="number" class="form-control" asp-for="Price" />
            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Book Cover Image</label>
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <div class="mb-2">
                    <img src="/images/@Model.Image" class="img-thumbnail" style="width: 100px; height: 80px;" />
                </div>
            }
            <input type="file" class="form-control" asp-for="ImageFile" />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-warning w-100">
                <i class="bi bi-save"></i> Update Book
            </button>
        </div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
