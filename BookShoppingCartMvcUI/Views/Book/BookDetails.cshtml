@model BookShoppingCart.Models.Models.Book

@{
    Layout = "_Layout";
}

<div class="container my-5">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4">
                <img src="/images/@(string.IsNullOrWhiteSpace(Model.Image) ? "NoImage.png" : Model.Image)"
                     alt="@Model.BookName"
                     class="img-fluid rounded-4 shadow-sm"
                     style="max-height: 450px; object-fit: contain;" />
            </div>
            <div class="col-md-7 p-5 d-flex flex-column justify-content-center">
                <h2 class="fw-bold text-dark mb-3">@Model.BookName</h2>

                <div class="mb-3">
                    <span class="badge bg-secondary me-2"><i class="bi bi-person"></i> @Model.AuthorName</span>
                </div>

                <div class="mb-4">
                    <strong class="fs-4 text-success">₹@Model.Price.ToString("N2")</strong>
                </div>

                <p class="@(Model.Quantity > 0 ? "text-success" : "text-danger")">@(Model.Quantity > 0 ? "In stock" : "Out of stock")</p>
                <div class="d-flex flex-wrap gap-3">
                    @if (Model.Quantity > 0)
                    {
                        if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Cart" asp-action="AddItem" method="post" class="d-flex gap-2">
                                <input type="hidden" name="bookId" value="@Model.Id" />
                                <input type="hidden" name="redirect" value="1" />
                                <input type="number" name="qty" value="1" min="1" max="@Math.Min(Model.Quantity, 1000)" aria-label="Quantity" class="form-control" style="width:85px" required />
                                <button class="btn btn-warning" type="submit">Add to cart</button>
                            </form>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-warning">Sign in to add to cart</a>
                        }
                    }
                    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-dark rounded-pill px-4 py-2">
                        <i class="bi bi-arrow-left-circle me-2"></i>Back to List
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>
