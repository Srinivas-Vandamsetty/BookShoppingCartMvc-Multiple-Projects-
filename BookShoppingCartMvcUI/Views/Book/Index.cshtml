@using BookShoppingCart.Models.Models
@model IEnumerable<Book>
@{
    Layout = "_AdminLayout";
}

<section class="admin-page">
    <div class="admin-page__header">
        <div><h1><i class="bi bi-bookshelf"></i>Books</h1><p>Manage your catalogue, pricing, genres, and book covers.</p></div>
        <a asp-action="AddBook" asp-controller="Book" class="btn btn-warning">
            <i class="bi bi-plus-circle me-1"></i> Add New Book
        </a>
    </div>



    @if (Model?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table admin-books-table align-middle table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Image</th>
                        <th>Book</th>
                        <th>Author</th>
                        <th>Genre</th>
                        <th>Price</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td>
                                <img src="/images/@(string.IsNullOrWhiteSpace(book.Image) ? "NoImage.png" : book.Image)"
                                     class="img-thumbnail rounded shadow-sm" alt="Book Cover" />
                            </td>
                            <td class="fw-semibold"><span class="admin-book-title">@book.BookName</span></td>
                            <td><span class="admin-book-author">@book.AuthorName</span></td>
                            <td>
                                <span class="badge bg-info text-dark">@book.Genre.GenreName</span>
                            </td>
                            <td class="fw-bold text-success">₹@book.Price.ToString("N2")</td>
                            <td>
                                <div class="admin-table-actions" role="group">
                                    <a asp-action="UpdateBook" asp-controller="Book" asp-route-id="@book.Id"
                                       class="btn btn-success btn-sm">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <form asp-action="DeleteBook" method="post" class="d-inline">
<input type="hidden" name="id" value="@book.Id" />
<button type="submit" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Delete
                                    </button></form>
                                    <form asp-action="CloneBook" method="post" class="d-inline">
<input type="hidden" name="id" value="@book.Id" />
<button type="submit" class="btn btn-warning btn-sm">
                                        <i class="bi bi-files"></i> Clone Book
                                    </button></form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-3">
            No records found. Click <strong>Add New Book</strong> to get started.
        </div>
    }
</section>

<partial name="_OrderPaging" />
