<div class="bookverse-account-actions">
    <a class="bookverse-icon-button bookverse-cart-button" href="/Cart/GetUserCart" aria-label="Open shopping cart">
        <i class="bi bi-cart3"></i>
        <span id="cartCount" class="bookverse-cart-count">0</span>
    </a>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="bookverse-account-link" asp-area="Identity" asp-page="/Account/Manage/Index" aria-label="Open your profile">
            <span class="bookverse-account-avatar"><i class="bi bi-person-fill"></i></span>
            <span><small>Welcome back</small><strong id="username">@User.Identity?.Name</strong></span>
            <i class="bi bi-chevron-down"></i>
        </a>
    }
    else
    {
        <a class="btn bookverse-signup-button" asp-area="Identity" asp-page="/Account/Register">Sign Up</a>
    }
</div>
